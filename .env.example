# --- Google service account (Sheets API) ---
# Email of the service account you created in Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key from the service account's JSON key file.
# Keep the quotes and the \n escape sequences exactly as they appear in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Spreadsheet ---
# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Name of the tab inside the spreadsheet that holds the registry items.
GOOGLE_SHEET_TAB=Items

# --- Admin page ---
# Password to unlock /admin, where you generate personalized guest links + QR codes.
ADMIN_PASSWORD=change-me

# --- Site ---
# Full public URL of the deployed app (used to build shareable links). No trailing slash.
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
