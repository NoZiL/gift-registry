# --- Google service account (Sheets API) ---
# Email of the service account you created in Google Cloud Console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key from the service account's JSON key file.
#
# The quotes below are shell/dotenv syntax and belong in THIS file only. Do NOT
# include them when pasting into a hosting dashboard (Vercel, Netlify, ...) --
# those fields store the literal characters, and the stray quotes make the key
# unparseable. There, paste the key on its own: either the real multi-line PEM
# or the \n-escaped JSON form, both of which are accepted.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Spreadsheet ---
# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# Optional. Name of the tab inside the spreadsheet holding the registry items.
# Leave unset to use the first tab, which is what you want for a single-tab
# sheet. Set it only when the spreadsheet has several tabs. Stray whitespace and
# casing are forgiven; a name that matches no tab fails with the list of real
# tab names.
GOOGLE_SHEET_TAB=

# --- Admin page ---
# Password to unlock /admin, where you generate personalized guest links + QR codes.
ADMIN_PASSWORD=change-me

# --- Site ---
# Full public URL of the deployed app (used to build shareable links). No trailing slash.
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
